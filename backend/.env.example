# BookSphere Express Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS (support comma-separated origins for production)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1h

# Python FastAPI Microservice Integration
FASTAPI_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=your_secure_service_to_service_token_here
